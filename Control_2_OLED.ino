// ======================================================
// Autor: Uriel Engine
// Fecha: 25 Sep 2026
// 
// Sketch para manejar 2 pantallas OLED de 128x64 por I2C
// con una tarjeta ESP32 S3 Super Mini (se puede adaptar
// a Arduino UNO Cambiando las líneas de Wire.begin y usar
// los pines A5 y A5)
// ======================================================
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ======================================================
// CONFIGURACIÓN I2C 
// NOTA: Esto es para la tarjeta ESP32 S3 super mini. 
// Si usas arduino UNO cambian los pines, 
// ya estan pre-definidos por la librería: SDA = A4 y SCL A5
// No olvides que tambien debes modificar la línea del Wire.begin
// ======================================================

#define SDA_PIN 8
#define SCL_PIN 9

// ======================================================
// CONFIGURACIÓN DE PANTALLAS
// ======================================================

#define ANCHO_PANTALLA 128
#define ALTO_PANTALLA 64

#define DIRECCION_OLED_A 0x3C
#define DIRECCION_OLED_B 0x3D

#define OLED_RESET -1

Adafruit_SSD1306 pantallaA(
  ANCHO_PANTALLA,
  ALTO_PANTALLA,
  &Wire,
  OLED_RESET
);

Adafruit_SSD1306 pantallaB(
  ANCHO_PANTALLA,
  ALTO_PANTALLA,
  &Wire,
  OLED_RESET
);


