// ======================================================

void setup() {

  // Inicializamos el bus I2C
	// NOTA: si usas arduino UNO aqui camnbia a   Wire.begin();
  Wire.begin(SDA_PIN, SCL_PIN);
  delay(100);

  // ==================================================
  // INICIAR PANTALLA A
  // Dirección 0x3C
  // ==================================================

  if (!pantallaA.begin(
        SSD1306_SWITCHCAPVCC,
        DIRECCION_OLED_A,
        false,
        false)) {

    while (true);
  }

  // ==================================================
  // INICIAR PANTALLA B
  // Dirección 0x3D
  // ==================================================

  if (!pantallaB.begin(
        SSD1306_SWITCHCAPVCC,
        DIRECCION_OLED_B,
        false,
        false)) {

    while (true);
  }

}


